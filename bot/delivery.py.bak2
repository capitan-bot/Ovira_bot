"""Small helpers shared by the shop handlers: per-user lock, admin alerts, sending config files."""
import asyncio
import io
import logging
from collections import defaultdict
from urllib.parse import quote

import httpx
from aiogram import Bot
from aiogram.types import BufferedInputFile, InlineKeyboardMarkup, InlineKeyboardButton

from adapters.base import ConfigFile
from config.settings import get_settings

log = logging.getLogger(__name__)
_locks: dict[int, asyncio.Lock] = defaultdict(asyncio.Lock)


def user_lock(user_id: int) -> asyncio.Lock:
    return _locks[user_id]


async def notify_admins(bot: Bot, text: str) -> None:
    for admin_id in get_settings().admin_telegram_ids:
        try:
            await bot.send_message(admin_id, text[:4000])
        except Exception as e:
            log.warning("Could not alert admin %s: %s", admin_id, e)


def _detect_protocol(text: str, filename: str) -> str:
    t = text.strip().lower()
    fn = filename.lower()
    if t.startswith("vless://"):
        return "VLESS"
    if t.startswith("vmess://"):
        return "VMess"
    if t.startswith("trojan://"):
        return "Trojan"
    if t.startswith("ss://"):
        return "Shadowsocks"
    if t.startswith("wg://") or "[interface]" in t or fn.endswith(".conf"):
        return "WireGuard"
    if ("client" in t and "dev tun" in t) or fn.endswith(".ovpn"):
        return "OpenVPN"
    if "amnezia" in fn or t.startswith("vpn://"):
        return "Amnezia"
    if "cisco" in fn or "anyconnect" in t:
        return "Cisco"
    if t.startswith(("http://", "https://")):
        return "Subscription"
    return "اختصاصی"


def _copy_kb(text_to_copy: str, label: str = "📋 کپی کانفیگ") -> InlineKeyboardMarkup | None:
    try:
        from aiogram.types import CopyTextButton
        return InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text=label, copy_text=CopyTextButton(text=text_to_copy))]
        ])
    except Exception:
        return None


def _rating_kb() -> InlineKeyboardMarkup:
    return InlineKeyboardMarkup(inline_keyboard=[
        [
            InlineKeyboardButton(text="1 ⭐️", callback_data="rate_star:1"),
            InlineKeyboardButton(text="2 ⭐️", callback_data="rate_star:2"),
            InlineKeyboardButton(text="3 ⭐️", callback_data="rate_star:3"),
            InlineKeyboardButton(text="4 ⭐️", callback_data="rate_star:4"),
            InlineKeyboardButton(text="5 ⭐️", callback_data="rate_star:5"),
        ]
    ])


async def _make_qr(data: str) -> bytes | None:
    try:
        import qrcode
        qr = qrcode.QRCode(version=1, box_size=8, border=2)
        qr.add_data(data)
        qr.make(fit=True)
        img = qr.make_image(fill_color="black", back_color="white")
        buf = io.BytesIO()
        img.save(buf, format="PNG")
        return buf.getvalue()
    except Exception:
        try:
            url = f"https://api.qrserver.com/v1/create-qr-code/?size=350x350&data={quote(data)}"
            async with httpx.AsyncClient(timeout=10.0) as client:
                r = await client.get(url)
                if r.status_code == 200:
                    return r.content
        except Exception as e:
            log.warning("QR generation failed: %s", e)
    return None


async def send_files(bot: Bot, chat_id: int, files: list[ConfigFile], sub_link: str | None) -> bool:
    sent = False

    for f in files:
        try:
            text_content = f.content.decode("utf-8").strip()
        except Exception:
            text_content = ""

        proto = _detect_protocol(text_content, f.filename)
        lines = [ln.strip() for ln in text_content.splitlines() if ln.strip()]
        is_uri_list = bool(lines) and all(
            ln.lower().startswith(("vless://", "vmess://", "trojan://", "ss://", "hy2://", "hysteria2://", "tuic://", "vpn://"))
            for ln in lines
        )

        if is_uri_list:
            for idx, uri in enumerate(lines, 1):
                p_name = _detect_protocol(uri, f.filename)
                caption = (
                    f"💎 <b>ممنون از خرید شما!</b>\n"
                    f"🔌 <b>نوع پروتکل:</b> <code>{p_name}</code>\n\n"
                    f"👇 <b>کانفیگ شما:</b>\n"
                    f"<code>{uri}</code>"
                )
                if sub_link:
                    caption += f"\n\n🌐 <b>لینک اشتراک (Sub):</b>\n<code>{sub_link}</code>"

                kb_markup = _copy_kb(uri, "📋 کپی کانفیگ")
                qr_bytes = await _make_qr(uri)
                try:
                    if qr_bytes:
                        await bot.send_photo(
                            chat_id,
                            BufferedInputFile(qr_bytes, filename=f"qr_{idx}.png"),
                            caption=caption,
                            parse_mode="HTML",
                            reply_markup=kb_markup,
                        )
                    else:
                        await bot.send_message(
                            chat_id,
                            caption,
                            parse_mode="HTML",
                            reply_markup=kb_markup,
                        )
                    sent = True
                except Exception as e:
                    log.warning("sending text config failed: %s", e)
        elif text_content.startswith(("http://", "https://")) and len(lines) == 1:
            if not sub_link:
                sub_link = text_content
        else:
            try:
                caption = (
                    f"💎 <b>ممنون از خرید شما!</b>\n"
                    f"🔌 <b>نوع پروتکل:</b> <code>{proto}</code>"
                )
                if sub_link:
                    caption += f"\n\n🌐 <b>لینک اشتراک (Sub):</b>\n<code>{sub_link}</code>"
                await bot.send_document(
                    chat_id,
                    BufferedInputFile(f.content, filename=f.filename),
                    caption=caption,
                    parse_mode="HTML",
                    reply_markup=_copy_kb(sub_link, "📋 کپی لینک اشتراک") if sub_link else None,
                )
                sent = True
            except Exception as e:
                log.warning("sending %s failed: %s", f.filename, e)

    if sub_link:
        sub_caption = (
            f"💎 <b>ممنون از خرید شما!</b>\n"
            f"🔌 <b>نوع پروتکل:</b> <code>لینک هوشمند اشتراک (Subscription)</code>\n\n"
            f"🌐 <b>لینک ساب شما:</b>\n"
            f"<code>{sub_link}</code>"
        )
        kb_sub = _copy_kb(sub_link, "📋 کپی لینک اشتراک")
        qr_sub = await _make_qr(sub_link)
        try:
            if qr_sub:
                await bot.send_photo(
                    chat_id,
                    BufferedInputFile(qr_sub, filename="sub_qr.png"),
                    caption=sub_caption,
                    parse_mode="HTML",
                    reply_markup=kb_sub,
                )
            else:
                await bot.send_message(
                    chat_id,
                    sub_caption,
                    parse_mode="HTML",
                    reply_markup=kb_sub,
                )
            sent = True
        except Exception as e:
            log.warning("sending sub link failed: %s", e)

    if sent:
        try:
            await bot.send_message(
                chat_id,
                "🌟 <b>به سرویس ما چند ستاره می‌دهید؟</b>\nلطفاً امتیاز خود را از ۱ تا ۵ انتخاب کنید:",
                parse_mode="HTML",
                reply_markup=_rating_kb(),
            )
        except Exception as e:
            log.warning("sending rating prompt failed: %s", e)

    return sent
